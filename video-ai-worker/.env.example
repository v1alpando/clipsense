# Working directory for intermediate files (extracted audio/frames) per run.
WORK_DIR=./work

# faster-whisper model size: tiny / base / small / medium / large-v3
# Bigger = more accurate, slower, more RAM. "base" is a reasonable CPU default.
WHISPER_MODEL_SIZE=base

# Hugging Face model id for the captioning model.
VISION_MODEL_ID=Salesforce/blip-image-captioning-base

# Extract one frame every N seconds for visual analysis.
FRAME_INTERVAL_SECONDS=2.0
